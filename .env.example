# Copy this file to .env.local for local dev (gitignored) and set the same
# values in your Netlify site's environment variables for deployment.
#
# All of these are PUBLIC values, safe to expose in the built frontend —
# see src/lib/supabaseClient.ts and src/lib/crypto.ts for why each one is
# safe. Found in your Supabase project at Settings -> API.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional (Phase 4, optional privacy layer). A public, non-secret value —
# pick any unique random string per deployment (e.g. `openssl rand -hex 16`)
# and set the SAME value for both people, since it has to match to derive
# the same encryption key. If unset, a shared default is used, which is
# fine to start with but weaker against a rainbow-table attack targeting
# this app specifically — see src/lib/crypto.ts.
VITE_ENCRYPTION_SALT=
