# Copy this file to .env.local for local dev (gitignored) and set the same
# values in your Netlify site's environment variables for deployment.
#
# All of these are PUBLIC values, safe to expose in the built frontend —
# see src/lib/supabaseClient.ts and src/lib/crypto.ts for why each one is
# safe. Found in your Supabase project at Settings -> API.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional. Only used by a room that existed before multi-room support
# (migration 0007) — every room created since has its own random salt. If you
# already set this, never change it: the same passphrase with a different
# salt derives a different key, and everything that room encrypted becomes
# unreadable. A fresh deployment can leave it empty.
VITE_ENCRYPTION_SALT=
