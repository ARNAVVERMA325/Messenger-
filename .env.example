# Copy this file to .env.local for local dev (gitignored) and set the same
# two values in your Netlify site's environment variables for deployment.
#
# Both are PUBLIC values (see src/lib/supabaseClient.ts for why that's safe)
# — found in your Supabase project at Settings -> API.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
